<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear wipes out any inherited sources (like a broken local folder
         reference from another project's NuGet.Config) and uses only
         nuget.org for this project -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
